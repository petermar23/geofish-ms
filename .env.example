# GeoFish MS - Configuração de Variáveis de Ambiente

# 1. Inteligência Artificial Google Gemini
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_SUA_CHAVE_AQUI"
VITE_GEMINI_API_KEY="AIzaSy_SUA_CHAVE_AQUI"

# 2. Firebase Cloud Firestore (Console: https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY="AIzaSy_SUA_CHAVE_FIREBASE"
VITE_FIREBASE_AUTH_DOMAIN="geofish-ms.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="geofish-ms"
VITE_FIREBASE_STORAGE_BUCKET="geofish-ms.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
