      "type": "line",
      "source": "rios_principais",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "titulo"
          ],
          "Rio Miranda",
          "#0284c7",
          "Rio Negro",
          "#0f766e",
          "Rio Aquidauana",
          "#0369a1",
          "Rio Paraguai",
          "#1d4ed8",
          "Rio Taquari",
          "#2563eb",
          "#0284c7"
        ],
        "line-width": [
          "match",
          [
            "get",
            "titulo"
          ],
          "Rio Miranda",
          3.8,
          "Rio Negro",
          3.2,
          "Rio Paraguai",
          3.8,
          2.6
        ]
