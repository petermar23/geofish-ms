    "sources_credits": [
      "IMASUL",
      "ANA",
      "ICMBio",
      "IBGE",
      "PMA-MS"
    ],
    "crs": "EPSG:4326",
    "repository": "https://github.com/petermar23/geofish-ms"
  },
  "sources": {
    "osm-base": {
      "type": "raster",
