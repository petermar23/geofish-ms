      "type": "fill",
      "source": "bacia_miranda",
      "paint": {
        "fill-color": "#2563eb",
        "fill-opacity": 0.05
      }
    },
    {
      "id": "bacia_miranda-line",
      "type": "line",
      "source": "bacia_miranda",
      "paint": {
        "line-color": "#2563eb",
        "line-width": 2,
        "line-dasharray": [
          4,
          2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "bacias_especiais-fill",
      "type": "fill",
      "source": "bacias_especiais",
      "paint": {
        "fill-color": "#06b6d4",
        "fill-opacity": 0.22
      }
    },
    {
      "id": "bacias_especiais-line",
      "type": "line",
      "source": "bacias_especiais",
      "paint": {
        "line-color": "#0891b2",
        "line-width": 2,
        "line-opacity": 0.9
      }
    },
    {
      "id": "uc_ms-fill",
      "type": "fill",
      "source": "uc_ms",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "grupo"
          ],
          "Proteção Integral",
          "rgba(239, 68, 68, 0.28)",
          "Uso Sustentável",
          "rgba(16, 185, 129, 0.28)",
          "rgba(20, 184, 166, 0.25)"
