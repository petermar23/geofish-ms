        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": 3,
        "line-opacity": 0.4
      }
    },
    {
      "id": "hidrografia-line",
      "type": "line",
      "source": "hidrografia",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "status_pesca"
          ],
          "Proibida",
          "#dc2626",
          "Pesque e Solte",
          "#f59e0b",
          "Permitida com Cota",
          "#0284c7",
          "#0284c7"
        ],
        "line-width": [
          "match",
          [
            "get",
            "status_pesca"
          ],
          "Proibida",
          2.4,
          "Pesque e Solte",
          2.0,
          "Permitida com Cota",
          1.2,
          1.2
        ]
      }
    },
    {
      "id": "rios_principais-casing",
      "type": "line",
      "source": "rios_principais",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": 5.5,
        "line-opacity": 0.7
      }
    },
