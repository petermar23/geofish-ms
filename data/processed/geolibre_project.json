      "id": "aglomerados_rurais-fill",
      "type": "fill",
      "source": "aglomerados_rurais",
      "paint": {
        "fill-color": "#f59e0b",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "aglomerados_rurais-line",
      "type": "line",
      "source": "aglomerados_rurais",
      "paint": {
        "line-color": "#d97706",
        "line-width": 1.8,
        "line-opacity": 0.9
      }
    },
    {
      "id": "pontos_apoio_fiscalizacao-circle",
      "type": "circle",
      "source": "pontos_apoio_fiscalizacao",
      "paint": {
        "circle-radius": 6.5,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff",
        "circle-color": [
          "match",
          [
            "get",
            "categoria"
          ],
          "Posto PMA (Lacre GCP)",
          "#ef4444",
          "Marco Normativo",
          "#eab308",
          "Rampa Náutica / Porto",
          "#0d9488",
          "Resgate e Emergência",
          "#dc2626",
          "#3b82f6"
