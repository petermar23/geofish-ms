        "fill-opacity": 0.7
      }
    },
    {
      "id": "uc_ms-line",
      "type": "line",
      "source": "uc_ms",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "grupo"
          ],
          "Proteção Integral",
          "#dc2626",
          "Uso Sustentável",
          "#059669",
          "#0d9488"
        ],
        "line-width": 1.8,
        "line-opacity": 0.95
      }
    },
    {
      "id": "hidrografia-casing",
      "type": "line",
