      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    },
    "bacia_miranda": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/bacia_miranda.geojson",
      "attribution": "ANA / IMASUL"
    },
    "bacias_especiais": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/bacias_especiais.geojson",
      "attribution": "IMASUL - Rios Cênicos"
    },
    "uc_ms": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/uc_ms.geojson",
      "attribution": "ICMBio / IMASUL"
    },
    "hidrografia": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/hidrografia.geojson",
      "attribution": "IMASUL / PMA-MS / Cartilha do Pescador 2023"
    },
    "rios_principais": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/rios_principais.geojson",
      "attribution": "ANA / IMASUL"
    },
    "aglomerados_rurais": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/aglomerados_rurais.geojson",
      "attribution": "IBGE"
    },
    "pontos_apoio_fiscalizacao": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/petermar23/geofish-ms/main/data/processed/pontos_apoio_fiscalizacao.geojson",
      "attribution": "Cartilha PMA 2023 / OpenStreetMap"
    }
